# Junk files that macOS / Linux desktops leave on the CIRCUITPY drive
.fseventsd/
.Trash*/
.Trashes
.metadata_never_index
# regenerated by CircuitPython on every boot
boot_out.txt
# may hold Wi-Fi passwords / API keys (never commit these)
settings.toml
wifi.json
# the board's runtime state (current match, history with player names, settings, remembered names):
# written by the board itself, private, and copying it back would overwrite the board's real state
data/
